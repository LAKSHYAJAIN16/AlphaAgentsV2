# Models run locally via Ollama (https://ollama.com) — no API keys needed.
# 1. Install Ollama and run `ollama serve`.
# 2. Pull each model assigned in config/models.py, e.g.:
#      ollama pull llama3.1:8b
#      ollama pull qwen2.5:14b
#      ollama pull mistral:7b
#      ollama pull gemma2:9b
#      ollama pull deepseek-r1:14b
#      ollama pull mixtral:8x7b
# Only override this if Ollama isn't running on its default local port.
OLLAMA_HOST=http://localhost:11434

# Required for the Fundamental Agent: SEC requires a descriptive User-Agent
# identifying the requester (https://www.sec.gov/os/webmaster-faq#developers).
# Free, no registration — just a real contact string, e.g.:
SEC_EDGAR_USER_AGENT=AlphaAgentsV2 research you@example.com

# Optional: news/sentiment data provider. Left blank, the Sentiment Agent
# falls back to a reduced feature set and is excluded from single-agent
# backtests (matches the original paper's stated limitation).
NEWS_API_KEY=
