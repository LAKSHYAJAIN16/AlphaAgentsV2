# At least ANTHROPIC_API_KEY is required. The others are optional and only
# needed if you assign a non-Claude model to a given agent role (see
# config/models.py) to get model-heterogeneous debate.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: news/sentiment data provider. Left blank, the Sentiment Agent
# falls back to a reduced feature set and is excluded from single-agent
# backtests (matches the original paper's stated limitation).
NEWS_API_KEY=
